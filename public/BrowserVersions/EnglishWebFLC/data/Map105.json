tern":0},"list":[{"code":230,"indent":0,"parameters":[30]},{"code":231,"indent":0,"parameters":[1,"littlediary0",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,255,0,60,true]},{"code":230,"indent":0,"parameters":[30]},{"code":101,"indent":0,"parameters":["",0,0,2]},{"code":401,"indent":0,"parameters":["Mountain God's Work Notes: From One Snow Mountain to"]},{"code":401,"indent":0,"parameters":["Another"]},{"code":102,"indent":0,"parameters":[["Read","Leave"],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"Read"]},{"code":250,"indent":1,"parameters":[{"name":"Book2","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":1,"parameters":[1,"littlediary1",0,0,0,0,100,100,255,0]},{"code":230,"indent":1,"parameters":[30]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["From One Snow Mountain to Another: I am a cat mountain"]},{"code":401,"indent":1,"parameters":["god, originally responsible for a snow mountain somewhere"]},{"code":401,"indent":1,"parameters":["in the Northeast. Due to a work transfer, I have temporarily"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["come to the Yulong Mountains in the south. It's still a snowy"]},{"code":401,"indent":1,"parameters":["mountain!"]},{"code":230,"indent":1,"parameters":[15]},{"code":250,"indent":1,"parameters":[{"name":"Book1","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":1,"parameters":[1,"littlediary2",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["I heard this place used to imprison the Ancestral Dragon, a"]},{"code":401,"indent":1,"parameters":["forbidden land ordinary immortals could not set foot in. Later,"]},{"code":401,"indent":1,"parameters":["some things happened, and it slowly fell into ruin."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Strange. Blue-flamed ladybugs and evil floaters often appear"]},{"code":401,"indent":1,"parameters":["nearby. Could there really be a secret entrance to the"]},{"code":401,"indent":1,"parameters":["underworld here? This is my territory, so I must investigate it"]},{"code":401,"indent":1,"parameters":["clearly!"]},{"code":230,"indent":1,"parameters":[15]},{"code":250,"indent":1,"parameters":[{"name":"Book1","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":1,"parameters":[1,"littlediary3",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Today, while patrolling the mountain, I suddenly felt that the"]},{"code":401,"indent":1,"parameters":["spiritual energy nearby was extremely abundant. On closer"]},{"code":401,"indent":1,"parameters":["taste, it was just like the clouds in Heaven, pure without a"]},{"code":401,"indent":1,"parameters":["trace of impurity, and very sweet."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["I tried stimulating it a little, and lots and lots of clover grew."]},{"code":401,"indent":1,"parameters":["How magical! This is a snowy mountaintop covered in snow"]},{"code":401,"indent":1,"parameters":["all year round! Ah, it's actually four-leaf clover! How lucky!"]},{"code":230,"indent":1,"parameters":[15]},{"code":250,"indent":1,"parameters":[{"name":"Book1","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":1,"parameters":[1,"littlediary4",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["The tourist attraction at the foot of the snowy mountain is"]},{"code":401,"indent":1,"parameters":["thriving, with people coming and going. But human spiritual"]},{"code":401,"indent":1,"parameters":["energy is far too complicated..."]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["I tried using the spiritual energy around here to plant a lantern"]},{"code":401,"indent":1,"parameters":["grass, which can both glow like a light bulb and give off heat"]},{"code":401,"indent":1,"parameters":["like a stove. Wonderful!"]},{"code":230,"indent":1,"parameters":[15]},{"code":250,"indent":1,"parameters":[{"name":"Book1","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":1,"parameters":[1,"littlediary5",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["There is a place where several branches of winter plum"]},{"code":401,"indent":1,"parameters":["grow, with super strong winds and super heavy snow all day"]},{"code":401,"indent":1,"parameters":["long. This is obviously a spell hiding a mountain area. I"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["mean... what can't they let a transferred mountain god know"]},{"code":401,"indent":1,"parameters":["directly?"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Today I absolutely have to take a look. With the spiritual"]},{"code":401,"indent":1,"parameters":["power here, breaking the spell should be no problem."]},{"code":401,"indent":1,"parameters":["Mountain god dance, flower staff, circle around, turn every"]},{"code":401,"indent":1,"parameters":["seven steps!"]},{"code":230,"indent":1,"parameters":[15]},{"code":250,"indent":1,"parameters":[{"name":"Book1","volume":90,"pitch":100,"pan":0}]},{"code":231,"indent":1,"parameters":[1,"littlediary6",0,0,0,0,100,100,255,0]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Goodness...! It's a stone statue of a big doggy. Looks like the"]},{"code":401,"indent":1,"parameters":["so-called abandoned forbidden land is here. This cave is"]},{"code":401,"indent":1,"parameters":["extremely suspicious. Judging by its posture: 'If I do not enter"]},{"code":401,"indent":1,"parameters":["hell, who will?'"]},{"code":101,"indent":1,"parameters":["",0,0,2]},{"code":401,"indent":1,"parameters":["Although I am a curious kit