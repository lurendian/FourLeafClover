{"id":24,"autoRemovalTiming":1,"chanceByDamage":100,"traits":[],"iconIndex":369,"maxTurns":3,"message1":"Turned into Lord Rabbit!","message2":"","message3":"","message4":"Turned back into a fox!","minTurns":3,"motion":0,"name":"Transform into Lord Rabbit","note":"<Custom Apply Effect>\nif (user.isActor()) {\n    // Save the current actor's information\n    user._prevCharName = user._characterName;\n    user._prevCharIndex = user._characterIndex;\n    user._prevFaceName = user._faceName;\n    user._prevFaceIndex = user._faceIndex;\n    user._prevBattlerName = user._battlerName;\n\n    // Get the skills of actor ID 2\n    var ally = $gameActors.actor(2); // Get party member ID 2\n    if (ally) {\n        ally.skills().forEach(function(skill) {\n            if (!user.hasSkill(skill.id)) {\n                user.learnSkill(skill.id); // If the actor does not have this skill, learn it\n            }\n        });\n    }\n\n    // Record the skills gained during transformation (skills of actor ID 2)\n    user._newSkills = ally ? ally.skills().map(function(skill) {\n        return skill.id;\n    }) : [];\n    \n    var charName = 'Meimei';\n    var charIndex = 1;\n    var faceName = 'tuye';\n    var faceIndex = 0;\n    var battlerName = 'Tuye1';\n\n    // Set the transformed actor's appearance\n    user.setCharacterImage(charName, charIndex);\n    user.setFaceImage(faceName, faceIndex);\n    user.setBattlerImage(battlerName);\n    user.refresh();\n    $gamePlayer.refresh();\n}\n</Custom Apply Effect>\n\n<Custom Remove Effect>\nif (user.isActor()) {\n    // Restore the actor's appearance\n    var charName = user._prevCharName;\n    var charIndex = user._prevCharIndex;\n    var faceName = user._prevFaceName;\n    var faceIndex = user._prevFaceIndex;\n    var battlerName = user._prevBattlerName;\n\n    user.setCharacterImage(charName, charIndex);\n    user.setFaceImage(faceName, faceIndex);\n    user.setBattlerImage(battlerName);\n\n    // Remove skills gained during transformation (skills of party member ID 2)\n    user._newSkills.forEach(function(skillId) {\n        user.forgetSkill(skillId); // Remove party member ID 2's skills\n    });\n\n    // Clear temporary records\n    user._prevCharName = undefined;\n    user._prevCharIndex = undefined;\n    user._prevFaceName = undefined;\n    user._prevFaceIndex = undefined;\n    user._prevBattlerName = undefined;\n    user._newSkills = undefined; // Clear the record of added skills\n\n    user.refresh();\n    $gamePlayer.refresh();\n}\n</Custom Remove Effect>","overlay":0,"priority":50,"removeAtBattleEnd":false,"removeByDamage":false,"removeByRestriction":false,"removeByWalking":true,"restriction":0,"stepsToRemove":100},
