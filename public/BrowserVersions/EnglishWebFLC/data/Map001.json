alid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":241,"indent":0,"parameters":[{"name":"Sword","volume":70,"pitch":100,"pan":0}]},{"code":121,"indent":0,"parameters":[52,52,0]},{"code":121,"indent":0,"parameters":[66,66,0]},{"code":117,"indent":0,"parameters":[38]},{"code":230,"indent":0,"parameters":[60]},{"code":231,"indent":0,"parameters":[1,"warning1",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[""]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":235,"indent":0,"parameters":[1]},{"code":222,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[11,"warning2",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[11,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[""]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":235,"indent":0,"parameters":[11]},{"code":222,"indent":0,"parameters":[]},{"code":231,"indent":0,"parameters":[12,"warning3",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[12,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[""]},{"code":221,"indent":0,"parameters":[]},{"code":230,"indent":0,"parameters":[60]},{"code":235,"indent":0,"parameters":[12]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["20XX, Some City My name is Murong Xuechuan, a fox spirit"]},{"code":401,"indent":0,"parameters":["who cultivated to enlightenment. I currently live here and run"]},{"code":401,"indent":0,"parameters":["an antique shop. A lone fox, living a fairly stable life."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["This is probably the tenth year since I left my hometown, the"]},{"code":401,"indent":0,"parameters":["Caiyun Mountains. Originally, that place was home to some"]},{"code":401,"indent":0,"parameters":["divine beasts who had descended to the mortal world. Back"]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["then, in order to 'climb into high society,' I worked for Boss"]},{"code":401,"indent":0,"parameters":["Deer."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["Although it was work, aside from the occasional special"]},{"code":401,"indent":0,"parameters":["customer, that shop mostly involved odd jobs like cleaning"]},{"code":401,"indent":0,"parameters":["and moving goods. The food every day was pretty good too,"]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["and sometimes there were even big chicken legs. If I went"]},{"code":401,"indent":0,"parameters":["out with my companions, there would be roasted lizard and"]},{"code":401,"indent":0,"parameters":["grasshopper snacks."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["How carefree and happy it was—except ………… Companions?"]},{"code":401,"indent":0,"parameters":["Who were they? I can't even remember their names anymore."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["It's strange. Life there is vivid in my mind, but when it comes"]},{"code":401,"indent":0,"parameters":["to the divine beasts, everything is blurry. It's as if something"]},{"code":401,"indent":0,"parameters":["deliberately erased them from my mind."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["I lived happily like that for a few years, and then suddenly,"]},{"code":401,"indent":0,"parameters":["one day... Hmm—what exactly happened? I forgot. All I can"]},{"code":401,"indent":0,"parameters":["remember is a sea of fire and the injured Boss Deer. He"]},{"code":401,"indent":0,"parameters":["handed me a sword and the mask he always wore."]},{"code":231,"indent":0,"parameters":[13,"swordandmask",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[13,0,0,0,0,0,100,100,255,0,60,true]},{"code":101,"indent":0,"parameters":["",0,2,2]},{"code":401,"indent":0,"parameters":[" "]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[13]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["What was his name? What did he say? What did he look like?"]},{"code":401,"indent":0,"parameters":["What exactly happened?"]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["I don't know, and I don't want to know. I escaped, and I never"]},{"code":401,"indent":0,"parameters":["went back again."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["For a while, I suspected that my life in the shop had been one"]},{"code":401,"indent":0,"parameters":["very long dream. The treasured sword in the study, the mask"]},{"code":401,"indent":0,"parameters":["locked inside the cabinet. They are real."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["Recently, the symptoms of my amnesia have become more"]},{"code":401,"indent":0,"parameters":["and more obvious. I often forget what I did the day before. I"]},{"code":401,"indent":0,"parameters":["even dream of cages."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["I'm so scared, and very anxious. I have no choice but to use"]},{"code":401,"indent":0,"parameters":["sleeping pills to force myself to sleep. I started writing a"]},{"code":401,"indent":0,"parameters":["diary, trying to keep myself clear-headed."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["Oh right, a big-shot customer came to the shop recently."]},{"code":401,"indent":0,"parameters":["They spend quite generously. They seem to be a deity from"]},{"code":401,"indent":0,"parameters":["the capital, called 'Tu'er Ye.' How nice. When will I finally rise"]},{"code":401,"indent":0,"parameters":["straight to the top..."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["They said my shop felt 'familiar.' That it reminded them of 'a"]},{"code":401,"indent":0,"parameters":["friend from some memory.' …… Maybe we really did know"]},{"code":401,"indent":0,"parameters":["each other before."]},{"code":101,"indent":0,"parameters":["",0,2,1]},{"code":401,"indent":0,"parameters":["But if it involves that blank stretch of memory— I decided not"]},{"code":401,"indent":0,"parameters":["to invite trouble."]},{"code":231,"indent":0,"parameters":[1,"FourLeafClover",0,0,0,0,100,100,0,0]},{"code":232,"indent":0,"parameters":[1,0,0,0,0,0,100,100,255,0,180,true]},{"code":230,"indent":0,"parameters":[180]},{"code":242,"indent":0,"parameters":[5]},{"code":221,"indent":0,"parameters":[]},{"code":235,"indent":0,"parameters":[1]},{"code":201,"indent":0,"parameters":[0,2,15,5,4,0]},{"code":356,"indent":0,"parameters":["Lightmask_Opacity 0"]},{"code":121,"indent":0,"parameters":[27,27,0]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":true,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":5,"y":4},null]}